{
  "name": "kietfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Fullstack 3D Cybernetic Portfolio Monorepo for Mai Anh Kiệt",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=@kietfolio/frontend",
    "dev:backend": "npm run dev --workspace=@kietfolio/backend",
    "build:types": "tsc --project packages/shared-types/tsconfig.json",
    "build:frontend": "npm run build --workspace=@kietfolio/frontend",
    "build:backend": "npm run build --workspace=@kietfolio/backend",
    "build": "npm run build:types && npm run build:backend && npm run build:frontend",
    "test:frontend": "npm run test --workspace=@kietfolio/frontend",
    "test:backend": "npm run test --workspace=@kietfolio/backend",
    "test": "npm run test:frontend && npm run test:backend",
    "lint:frontend": "npm run lint --workspace=@kietfolio/frontend",
    "lint:backend": "npm run lint --workspace=@kietfolio/backend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "portfolio",
    "threejs",
    "react19",
    "gsap",
    "nodejs",
    "express",
    "postgresql",
    "docker",
    "fullstack"
  ],
  "author": "Mai Anh Kiệt <kiet.maianh@gmail.com>",
  "license": "MIT"
}
