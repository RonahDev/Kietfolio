{
  "name": "kietfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Fullstack 3D Cybernetic Portfolio Monorepo for Mai Anh Kiệt",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "npm --prefix apps/backend run dev",
    "build:types": "npm --prefix packages/shared-types run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build": "npm run build:types && npm run build:backend && npm run build:frontend",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:backend": "npm --prefix apps/backend run test",
    "test": "npm run test:frontend && npm run test:backend",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "lint:backend": "npm --prefix apps/backend run lint",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "portfolio",
    "threejs",
    "react19",
    "gsap",
    "nodejs",
    "express",
    "postgresql",
    "docker",
    "fullstack"
  ],
  "author": "Mai Anh Kiệt <kiet.maianh@gmail.com>",
  "license": "MIT"
}
