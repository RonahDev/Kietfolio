# =============================================================================
# Production Multi-Stage Dockerfile for Fastify v5 + Prisma (Node.js 22 LTS)
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependency Installation
# -----------------------------------------------------------------------------
FROM node:22-alpine AS deps
WORKDIR /app

# Install OpenSSL for Prisma engine compatibility on Alpine Linux
RUN apk add --no-cache openssl libc6-compat

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

# -----------------------------------------------------------------------------
# Stage 2: Build & Compile TypeScript
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder
WORKDIR /app

RUN apk add --no-cache openssl libc6-compat

COPY --from=deps /app/node_modules ./node_modules
COPY package*.json tsconfig.json ./
COPY prisma ./prisma/
COPY src ./src/

# Generate Prisma Client
RUN npx prisma generate

# Build TypeScript to JavaScript
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: Minimal Production Execution Image
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache openssl libc6-compat

# Copy package descriptors and install only production dependencies
COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci --omit=dev && npx prisma generate

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Non-root user for maximum Linux container security
USER node

EXPOSE 5000

# Start command: Apply migrations then boot Fastify v5 server
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]

