// =============================================================================
// Prisma Schema Definition - Movie Hub & Kietfolio Ecosystem
// PostgreSQL Production-Ready Database Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. AUTHENTICATION, RBAC & SESSIONS
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  displayName  String?   @map("display_name")
  photoUrl     String?   @map("photo_url")
  role         String    @default("user") // super_admin | admin | content_manager | moderator | analyst | vip | user
  status       String    @default("active") // active | suspended | pending
  provider     String    @default("password") // password | google
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  sessions            AdminSession[]
  userRoles           UserRole[]
  comments            Comment[]
  commentReports      CommentReport[]
  watchHistory        WatchHistory[]
  paymentTransactions PaymentTransaction[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Role {
  id              String           @id // super_admin, admin, content_manager, moderator, analyst, user
  name            String
  description     String?
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id // e.g. "movies.create", "movies.delete", "revenue.read"
  module          String           // "movies", "users", "revenue", "system", "taxonomies"
  description     String?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AdminSession {
  id             String    @id // Hex token from crypto.randomBytes(32)
  userId         String    @map("user_id")
  ipAddress      String    @map("ip_address")
  userAgent      String    @map("user_agent")
  deviceName     String    @map("device_name")
  expiresAt      DateTime  @map("expires_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model LoginAttempt {
  id            String    @id @default(uuid())
  ipAddress     String    @map("ip_address")
  email         String
  attemptCount  Int       @default(1) @map("attempt_count")
  lastAttemptAt DateTime  @default(now()) @map("last_attempt_at")
  lockedUntil   DateTime? @map("locked_until")

  @@index([ipAddress, email])
  @@map("login_attempts")
}

// -----------------------------------------------------------------------------
// 2. MOVIE CONTENT MANAGEMENT & METADATA
// -----------------------------------------------------------------------------

model Movie {
  id             String    @id @default(uuid())
  titleVi        String    @map("title_vi")
  titleOrigin    String?   @map("title_origin")
  slug           String    @unique
  type           String    @default("movie") // "movie" | "tv_series"
  synopsis       String?   @db.Text
  posterUrl      String    @map("poster_url")
  backdropUrl    String    @map("backdrop_url")
  trailerUrl     String?   @map("trailer_url")
  youtubeKey     String?   @map("youtube_key")
  videoStreamUrl String?   @map("video_stream_url")
  streamSource   String    @default("hls") @map("stream_source") // "hls" | "youtube" | "kkphim"
  releaseYear    Int       @map("release_year")
  duration       String?   // e.g. "148 min"
  rating         Float     @default(8.5)
  ageRating      String    @default("PG-13") @map("age_rating")
  quality        String    @default("4K ULTRA HD")
  audio          String    @default("DOLBY ATMOS")
  director       String?
  castData       Json?     @map("cast_data") // Array of { name, role, avatarUrl }
  tmdbId         Int?      @map("tmdb_id")
  status         String    @default("published") // "draft" | "published" | "hidden" | "scheduled"
  isTheatrical   Boolean   @default(false) @map("is_theatrical")
  isFeatured     Boolean   @default(false) @map("is_featured")
  viewCount      BigInt    @default(0) @map("view_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  genres         MovieGenre[]
  categories     MovieCategory[]
  seasons        Season[]
  episodes       Episode[]
  comments       Comment[]
  watchHistory   WatchHistory[]
  banners        Banner[]
  featuredMovies FeaturedMovie[]

  @@index([status])
  @@index([type])
  @@index([isTheatrical])
  @@index([releaseYear])
  @@map("movies")
}

model Genre {
  id     String       @id // e.g. "action", "sci-fi", "horror"
  nameVi String       @map("name_vi")
  nameEn String       @map("name_en")
  slug   String       @unique
  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String @map("movie_id")
  genreId String @map("genre_id")
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}

model Category {
  id           String          @id // e.g. "trending", "award-winning", "vietnam-cinema"
  nameVi       String          @map("name_vi")
  nameEn       String          @map("name_en")
  slug         String          @unique
  displayOrder Int             @default(0) @map("display_order")
  isActive     Boolean         @default(true) @map("is_active")
  movies       MovieCategory[]

  @@map("categories")
}

model MovieCategory {
  movieId    String   @map("movie_id")
  categoryId String   @map("category_id")
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([movieId, categoryId])
  @@map("movie_categories")
}

model Season {
  id           String    @id @default(uuid())
  movieId      String    @map("movie_id")
  seasonNumber Int       @map("season_number")
  title        String
  overview     String?   @db.Text
  movie        Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([movieId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id            String          @id @default(uuid())
  movieId       String          @map("movie_id")
  seasonId      String?         @map("season_id")
  episodeNumber Int             @map("episode_number")
  name          String
  slug          String
  synopsis      String?         @db.Text
  duration      String?
  thumbnailUrl  String?         @map("thumbnail_url")
  createdAt     DateTime        @default(now()) @map("created_at")

  movie   Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  season  Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sources EpisodeSource[]

  @@unique([movieId, episodeNumber])
  @@map("episodes")
}

model EpisodeSource {
  id         String  @id @default(uuid())
  episodeId  String  @map("episode_id")
  serverName String  @default("VIP HLS 4K") @map("server_name")
  videoUrl   String  @map("video_url")
  quality    String  @default("4K")
  status     String  @default("active") // "active" | "error"

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@map("episode_sources")
}

model VideoServer {
  id             String    @id @default(uuid())
  serverName     String    @map("server_name")
  provider       String
  baseStreamUrl  String    @map("base_stream_url")
  status         String    @default("online") // "online" | "degraded" | "offline"
  responseTimeMs Int?      @map("response_time_ms")
  lastCheckedAt  DateTime? @map("last_checked_at")

  @@map("video_servers")
}

model Banner {
  id           String    @id @default(uuid())
  movieId      String?   @map("movie_id")
  title        String
  subtitle     String?
  imageUrl     String    @map("image_url")
  ctaLink      String?   @map("cta_link")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")

  movie Movie? @relation(fields: [movieId], references: [id], onDelete: SetNull)

  @@map("banners")
}

model FeaturedMovie {
  id        String   @id @default(uuid())
  movieId   String   @map("movie_id")
  section   String   // "hero" | "trending" | "popular" | "recommended"
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@map("featured_movies")
}

// -----------------------------------------------------------------------------
// 3. COMMUNITY & INTERACTION
// -----------------------------------------------------------------------------

model Comment {
  id        String   @id @default(uuid())
  movieId   String   @map("movie_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  status    String   @default("published") // "published" | "pending" | "hidden" | "deleted"
  createdAt DateTime @default(now()) @map("created_at")

  movie   Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports CommentReport[]

  @@index([movieId])
  @@index([status])
  @@map("comments")
}

model CommentReport {
  id             String   @id @default(uuid())
  commentId      String   @map("comment_id")
  reporterUserId String   @map("reporter_user_id")
  reason         String
  status         String   @default("pending") // "pending" | "resolved" | "dismissed"
  createdAt      DateTime @default(now()) @map("created_at")

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@map("comment_reports")
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  movieId         String   @map("movie_id")
  progressSeconds Int      @default(0) @map("progress_seconds")
  percentage      Int      @default(0)
  completed       Boolean  @default(false)
  lastWatchedAt   DateTime @default(now()) @map("last_watched_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@map("watch_history")
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  transactionCode String    @unique @map("transaction_code")
  userId          String?   @map("user_id")
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String    @map("payment_method") // "vietcombank" | "momo" | "vnpay"
  status          String    @default("pending") // "completed" | "pending" | "failed" | "refunded"
  orderType       String    @default("coffee") @map("order_type") // "coffee" | "vip_upgrade" | "mentorship"
  donorName       String?   @map("donor_name")
  donorMessage    String?   @map("donor_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([paymentMethod])
  @@map("payment_transactions")
}

// -----------------------------------------------------------------------------
// 4. ANALYTICS & MONITORING
// -----------------------------------------------------------------------------

model TrafficEvent {
  id         String   @id @default(uuid())
  eventType  String   @map("event_type") // "page_view" | "movie_view" | "visit"
  path       String
  movieId    String?  @map("movie_id")
  userId     String?  @map("user_id")
  ipHash     String?  @map("ip_hash")
  deviceType String?  @map("device_type") // "desktop" | "mobile" | "tablet"
  browser    String?
  os         String?
  referrer   String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([eventType])
  @@map("traffic_events")
}

model TrafficDailyAggregate {
  date               DateTime @id @db.Date
  totalVisits        Int      @default(0) @map("total_visits")
  uniqueVisitors     Int      @default(0) @map("unique_visitors")
  pageViews          Int      @default(0) @map("page_views")
  movieViews         Int      @default(0) @map("movie_views")
  avgDurationSeconds Int      @default(0) @map("avg_duration_seconds")
  bounceRate         Float    @default(0.0) @map("bounce_rate")

  @@map("traffic_daily_aggregates")
}

model RevenueDailyAggregate {
  date            DateTime @id @db.Date
  grossRevenue    Decimal  @default(0) @db.Decimal(12, 2) @map("gross_revenue")
  netRevenue      Decimal  @default(0) @db.Decimal(12, 2) @map("net_revenue")
  refundAmount    Decimal  @default(0) @db.Decimal(12, 2) @map("refund_amount")
  successfulCount Int      @default(0) @map("successful_count")
  failedCount     Int      @default(0) @map("failed_count")

  @@map("revenue_daily_aggregates")
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?  @map("actor_id")
  actorRole     String?  @map("actor_role")
  action        String   // "movie.create", "user.suspend", "session.revoke", etc.
  entityType    String   @map("entity_type") // "Movie", "User", "Session"
  entityId      String?  @map("entity_id")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  detailsBefore Json?    @map("details_before")
  detailsAfter  Json?    @map("details_after")
  createdAt     DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
