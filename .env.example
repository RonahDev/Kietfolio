# ========================================================
# KIETFOLIO — FIREBASE GOOGLE AUTHENTICATION CONFIGURATION
# ========================================================
# 1. Truy cập https://console.firebase.google.com/
# 2. Tạo một dự án mới (hoặc dùng dự án hiện có)
# 3. Vào Build -> Authentication -> Sign-in method -> Bật "Google"
# 4. Vào Project Settings -> General -> Your apps -> Web app (</>)
# 5. Sao chép các thông số cấu hình và dán vào file `.env.local`:

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

